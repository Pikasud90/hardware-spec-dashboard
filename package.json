{
  "name": "hardware-spec-dashboard",
  "productName": "Hardware Spec Dashboard",
  "version": "4.0.0",
  "private": false,
  "license": "MIT",
  "description": "An offline-first PC hardware and laptop build planner, reference and comparison dashboard with Indian market pricing, compatibility checking and a quantitative visualisation suite.",
  "author": {
    "name": "Pikasud90"
  },
  "homepage": "https://github.com/Pikasud90/hardware-spec-dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pikasud90/hardware-spec-dashboard.git"
  },
  "keywords": [
    "pc-hardware",
    "cpu",
    "gpu",
    "benchmark",
    "comparison",
    "nextjs",
    "electron",
    "dataviz",
    "offline-first"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run verify:data && npm run lint && npm run build",
    "electron:dev": "cross-env HSD_DEV_SERVER=http://localhost:3000 electron .",
    "electron:preview": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:all": "npm run build && electron-builder --mac --win --publish never",
    "clean": "rimraf .next out release",
    "verify:data": "tsx --tsconfig tsconfig.json scripts/verify-data.ts",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.552.0",
    "next": "15.5.23",
    "nuqs": "^2.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
